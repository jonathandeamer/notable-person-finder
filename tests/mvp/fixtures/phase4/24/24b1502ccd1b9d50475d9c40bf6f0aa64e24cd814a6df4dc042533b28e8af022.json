ast[0].nodeType === 3 && isEmptyOrSpaces($last.text())) {\r\n                            $last.remove();\r\n                            $last = $this.contents().last();\r\n                            continue;\r\n                        }\r\n                        if ($last.is('br')) {\r\n                            $last.remove();\r\n                            $last = $(this).contents().last();\r\n                            continue;\r\n                        }\r\n                        return;\r\n                    }\r\n                });\r\n            });\r\n    </script>\r\n\r\n</body>\r\n</html>", "content_type": "text/html; charset=utf-8"}}